# ============================================
# KOPIRATI u .env.local i popuniti vrednosti
# ============================================

# URL sajta (bez trailing slash)
NEXT_PUBLIC_SITE_URL=https://www.benkabmb.com

# Naziv sajta
NEXT_PUBLIC_SITE_NAME=Benka BMB

# Google Analytics (opciono)
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Database (opciono, prilagodi po potrebi)
# DATABASE_URL=postgresql://user:password@localhost:5432/dbname

# Auth secret (opciono - ako koristis NextAuth/Lucia)
# AUTH_SECRET=

# Kontakt forma (Mailjet)
MAILJET_API_KEY=
MAILJET_SECRET_KEY=
SITE_MAIL_SENDER=
SITE_MAIL_RECEIVER=
